{
  "name": "test-github-actions",
  "version": "1.0.0",
  "description": "GitHub Actions を学ぶためのリポジトリ",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite app",
    "build": "vite build app",
    "preview": "vite preview app",
    "typecheck": "tsc --noEmit -p app",
    "test": "vitest run --root app",
    "test:watch": "vitest --root app"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
